
{
  
  "rewrites": [
    {
      "source": "/product/:path*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|whatsapp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Googlebot|bingbot).*"
        }
      ],
      "destination": "/api/product-preview?path=:path*"
    }
  ]
}
